# OPENROUTER_API_KEY: Free OpenRouter API Key for AI Market Analyst (get free key at openrouter.ai)
OPENROUTER_API_KEY=""

# OPENROUTER_MODEL: Free model identifier (default: meta-llama/llama-3.3-70b-instruct:free or google/gemini-2.0-flash-exp:free)
OPENROUTER_MODEL="meta-llama/llama-3.3-70b-instruct:free"

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# TELEGRAM_BOT_TOKEN: From @BotFather
TELEGRAM_BOT_TOKEN="8666440185:AAHMWIFvSH78CEmqG2RPEgoloELMkH2A_dM"

# TELEGRAM_USER_ID: Your numeric ID (get it from @userinfobot)
TELEGRAM_USER_ID="6851804399"

# POLYGON_PRIVATE_KEY: The private key for your Polygon wallet (for real trades)
POLYGON_PRIVATE_KEY="0x996813bc090a8fff275bf7efd14cc8675dae04eaa9808132acdf50df67ba5bd7"

# PROXY_ADDRESS: Your Polymarket proxy address (find in profile settings)
PROXY_ADDRESS="0xf83ed61D40419FFaeF62283Bf5d0884F418beC50"

# TRADING_LIMIT_PER_TRADE: Max USD to invest per snipe (default $1.00)
TRADING_LIMIT_PER_TRADE="1.00"

# SCAN_WINDOW_SECONDS: How far ahead to scan for upcoming markets (default 300)
SCAN_WINDOW_SECONDS="300"

# SNIPE_WINDOW_SECONDS: Seconds before expiry to execute the snipe (default 10)
SNIPE_WINDOW_SECONDS="10"

# MAX_DAILY_TRADES: Maximum number of trades to execute per day
MAX_DAILY_TRADES="500000"

# SNIPE_PRICE: Fixed price for the snipe order (default 0.97)
SNIPE_PRICE="0.97"

# Paper Trading
PAPER_MODE=true                    # Default: paper trading enabled
PAPER_INITIAL_BALANCE=10000        # Virtual starting balance (USDC)
PAPER_DB_PATH=./paper_trades.json  # JSON database path
